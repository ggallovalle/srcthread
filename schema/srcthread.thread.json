{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadMeta",
  "description": "Thread metadata (prose lives in `notes.md`).",
  "type": "object",
  "properties": {
    "created": {
      "description": "ISO-8601 timestamp.",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "updated": {
      "description": "ISO-8601 timestamp.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "created",
    "updated"
  ]
}
