#!/usr/bin/env bun
// vim: set ft=typescript:
//MISE description="Run Android detekt (ktlint wrapper) via Gradle"
//MISE dir="{{config_root}}"

import { join } from "node:path";
import { resolveMiseEnv, type MiseEnv } from "~/mise-env.ts";

export type Command = Record<string, never>;

export function parseCommand(
  _env: NodeJS.ProcessEnv = process.env,
): Command {
  return {};
}

export async function main(_command: Command, mise: MiseEnv): Promise<number> {
  // CI is Rust-only; GHA may set ANDROID_HOME to a partial SDK that breaks Gradle.
  if (process.env.CI === "true") {
    console.log("skip detekt (CI)");
    return 0;
  }

  const sdk = process.env.ANDROID_HOME || process.env.ANDROID_SDK_ROOT || "";
  const platforms = join(sdk, "platforms");
  const platformsOk = sdk
    ? await Bun.$`test -d ${platforms}`.nothrow().quiet()
    : { exitCode: 1 };
  if (!sdk || platformsOk.exitCode !== 0) {
    console.log("skip detekt (no usable Android SDK)");
    return 0;
  }

  await Bun.$`./gradlew :apps:android:detekt :ktpackages:srcthread:detekt`.cwd(
    mise.projectRoot,
  );
  return 0;
}

if (import.meta.main) {
  process.exit(await main(parseCommand(), resolveMiseEnv()));
}
