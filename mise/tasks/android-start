#!/usr/bin/env bun
// vim: set ft=typescript:
//MISE description="Build, install, and launch the Android app on emulator and/or device"
//USAGE flag "--emulator" help="Target reachable emulators only (fail if none)"
//USAGE flag "--device" help="Target reachable physical devices only (fail if none)"
//USAGE flag "--force" help="Allow installing over a higher versionCode (pm -d)"

import { resolveMiseEnv, type MiseEnv } from "~/mise-env.ts";

const APK = "apps/android/build/outputs/apk/debug/android-debug.apk";
// Debug APK uses applicationIdSuffix=.dev (side-by-side with non-dev installs).
const ACTIVITY = "dev.kbroom.srcthread.dev/dev.kbroom.srcthread.MainActivity";

/** Mirrors //USAGE above. */
export type Command = {
  emulator: boolean;
  device: boolean;
  force: boolean;
};

export function parseCommand(
  env: NodeJS.ProcessEnv = process.env,
): Command {
  return {
    emulator: env.usage_emulator === "true",
    device: env.usage_device === "true",
    force: env.usage_force === "true",
  };
}

async function onlineSerials(cwd: string): Promise<string[]> {
  const text = await Bun.$`adb devices`.cwd(cwd).text();
  const serials: string[] = [];
  for (const line of text.split("\n").slice(1)) {
    const [serial, status] = line.trim().split(/\s+/);
    if (serial && status === "device") serials.push(serial);
  }
  return serials;
}

export async function main(command: Command, mise: MiseEnv): Promise<number> {
  let wantEmulator = command.emulator;
  let wantDevice = command.device;
  let infer = false;
  // Neither flag → infer both kinds that are currently reachable.
  if (!wantEmulator && !wantDevice) {
    wantEmulator = true;
    wantDevice = true;
    infer = true;
  }

  const serials = await onlineSerials(mise.projectRoot);
  const emulators = serials.filter((s) => s.startsWith("emulator-"));
  let devices = serials.filter((s) => !s.startsWith("emulator-"));

  // Optional handset pin (ignored for emulators).
  const pinned =
    process.env.SRCTHREAD_ANDROID_SERIAL?.trim() ||
    process.env.ANDROID_SERIAL?.trim() ||
    "";
  if (pinned) {
    devices = devices.filter((s) => s === pinned);
  }

  const targets: string[] = [];
  if (wantEmulator) {
    if (emulators.length === 0) {
      if (!infer) {
        console.error("No reachable Android emulator (adb status=device)");
        return 1;
      }
    } else {
      targets.push(...emulators);
    }
  }
  if (wantDevice) {
    if (devices.length === 0) {
      if (!infer) {
        if (pinned) {
          console.error(
            `Pinned device ${pinned} is not reachable (adb status=device)`,
          );
        } else {
          console.error(
            "No reachable physical Android device (adb status=device)",
          );
        }
        return 1;
      }
    } else {
      targets.push(...devices);
    }
  }

  if (targets.length === 0) {
    console.error("No reachable Android emulator or physical device");
    return 1;
  }

  console.log(`Targets: ${targets.join(" ")}`);
  await Bun.$`./gradlew :apps:android:assembleDebug`.cwd(mise.projectRoot);

  for (const serial of targets) {
    console.log(`Installing on ${serial}`);
    if (command.force) {
      await Bun.$`android install --device=${serial} --apks ${APK} --install-options=-d`.cwd(
        mise.projectRoot,
      );
    } else {
      await Bun.$`android install --device=${serial} --apks ${APK}`.cwd(
        mise.projectRoot,
      );
    }
    await Bun.$`adb -s ${serial} shell am start -n ${ACTIVITY}`.cwd(
      mise.projectRoot,
    );
  }

  return 0;
}

if (import.meta.main) {
  process.exit(await main(parseCommand(), resolveMiseEnv()));
}
