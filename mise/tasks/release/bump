#!/usr/bin/env bun
// vim: set ft=typescript:
//MISE description="Bump lockstep product version (Cargo workspace + Android)"
//USAGE arg "<target>" help="X.Y.Z, or one of: patch, minor, major"
/**
 * Bump the lockstep product version: workspace Cargo.toml + Android.
 *
 * Does not commit. Run before: mise run release:publish <version>
 */

import { join, relative } from "node:path";
import { resolveMiseEnv, type MiseEnv } from "~/mise-env.ts";
import { bumpSemver, parseSemver, versionCode } from "~/semver.ts";
import {
  readWorkspaceVersion,
  writeAndroidVersion,
  writeWorkspaceVersion,
} from "~/version.ts";

/** Mirrors //USAGE above. */
export type Command = {
  target: string;
};

export type { MiseEnv };

export { resolveMiseEnv };

export function parseCommand(
  env: NodeJS.ProcessEnv = process.env,
): Command | { error: string } {
  const target = env.usage_target?.trim();
  if (!target) {
    return {
      error:
        "missing required arg <target> (usage_target); expected X.Y.Z|patch|minor|major",
    };
  }
  return { target };
}

export async function main(command: Command, mise: MiseEnv): Promise<number> {
  const cargoToml = join(mise.projectRoot, "Cargo.toml");
  const androidGradle = join(
    mise.projectRoot,
    "apps",
    "android",
    "build.gradle.kts",
  );

  if (!(await Bun.file(cargoToml).exists())) {
    console.error(`missing ${cargoToml}`);
    return 1;
  }
  if (!(await Bun.file(androidGradle).exists())) {
    console.error(`missing ${androidGradle}`);
    return 1;
  }

  const current = await readWorkspaceVersion(mise.projectRoot);
  if (typeof current !== "string") {
    console.error(current.error);
    return 1;
  }

  let version: string;
  if (
    command.target === "patch" ||
    command.target === "minor" ||
    command.target === "major"
  ) {
    const bumped = bumpSemver(current, command.target);
    if (typeof bumped !== "string") {
      console.error(bumped.error);
      return 1;
    }
    version = bumped;
  } else {
    const validated = parseSemver(command.target);
    if ("error" in validated) {
      console.error(validated.error);
      return 1;
    }
    version = command.target;
  }

  const parts = parseSemver(version);
  if ("error" in parts) {
    console.error(parts.error);
    return 1;
  }
  const code = versionCode(parts);

  const cargoErr = await writeWorkspaceVersion(mise.projectRoot, version);
  if (cargoErr) {
    console.error(cargoErr);
    return 1;
  }
  const androidErr = await writeAndroidVersion(
    mise.projectRoot,
    version,
    code,
  );
  if (androidErr) {
    console.error(androidErr);
    return 1;
  }

  console.log(`bumped ${current} -> ${version} (Android versionCode=${code})`);
  console.log(`  ${relative(mise.projectRoot, cargoToml)}`);
  console.log(`  ${relative(mise.projectRoot, androidGradle)}`);
  return 0;
}

if (import.meta.main) {
  const parsed = parseCommand();
  if ("error" in parsed) {
    console.error(parsed.error);
    process.exit(2);
  }
  process.exit(await main(parsed, resolveMiseEnv()));
}
