#!/usr/bin/env bun
//MISE description="Bump lockstep product version (Cargo workspace + Android)"
//USAGE arg "<target>" help="X.Y.Z, or one of: patch, minor, major"
/**
 * Bump the lockstep product version: workspace Cargo.toml + Android.
 *
 * Does not commit. Run before: mise run release:publish <version>
 */

import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { join, relative } from "node:path";

function projectRoot(): string {
  for (const key of ["MISE_PROJECT_ROOT", "MISE_CONFIG_ROOT"] as const) {
    const val = process.env[key];
    if (val) return val;
  }
  return process.cwd();
}

const ROOT = projectRoot();
const CARGO_TOML = join(ROOT, "Cargo.toml");
const ANDROID_GRADLE = join(ROOT, "apps", "android", "build.gradle.kts");

const SEMVER_RE = /^([0-9]+)\.([0-9]+)\.([0-9]+)$/;
const WORKSPACE_PACKAGE_RE = /^\[workspace\.package\][\s\S]*?(?=^\[|\Z)/m;
const WORKSPACE_VERSION_RE = /^version\s*=\s*"([^"]*)"/m;

function die(msg: string, code = 1): never {
  console.error(msg);
  process.exit(code);
}

function parseSemver(text: string): [number, number, number] {
  const m = SEMVER_RE.exec(text);
  if (!m) die(`version must be X.Y.Z digits (got ${JSON.stringify(text)})`);
  return [Number(m[1]), Number(m[2]), Number(m[3])];
}

function formatSemver(parts: [number, number, number]): string {
  return `${parts[0]}.${parts[1]}.${parts[2]}`;
}

function versionCode(parts: [number, number, number]): number {
  const [major, minor, patch] = parts;
  return major * 10000 + minor * 100 + patch;
}

function readWorkspaceVersion(cargoToml: string): string {
  const text = readFileSync(cargoToml, "utf8");
  const block = WORKSPACE_PACKAGE_RE.exec(text);
  if (!block) die("could not find [workspace.package] in Cargo.toml");
  const m = WORKSPACE_VERSION_RE.exec(block[0]);
  if (!m) die("could not find [workspace.package] version in Cargo.toml");
  return m[1];
}

function bumpSemver(current: string, kind: string): string {
  let [major, minor, patch] = parseSemver(current);
  if (kind === "major") {
    major += 1;
    minor = 0;
    patch = 0;
  } else if (kind === "minor") {
    minor += 1;
    patch = 0;
  } else if (kind === "patch") {
    patch += 1;
  } else {
    die(`unknown bump kind: ${kind}`);
  }
  return formatSemver([major, minor, patch]);
}

function writeWorkspaceVersion(cargoToml: string, version: string): void {
  const text = readFileSync(cargoToml, "utf8");
  let n = 0;
  const newText = text.replace(WORKSPACE_PACKAGE_RE, (block) => {
    n += 1;
    if (WORKSPACE_VERSION_RE.test(block)) {
      return block.replace(WORKSPACE_VERSION_RE, `version = "${version}"`);
    }
    return block.replace(
      /^(\[workspace\.package\]\n)/m,
      `$1version = "${version}"\n`,
    );
  });
  if (n !== 1) die("failed to update [workspace.package] version");
  writeFileSync(cargoToml, newText);
}

function writeAndroidVersion(
  gradle: string,
  version: string,
  code: number,
): void {
  let text = readFileSync(gradle, "utf8");
  let n1 = 0;
  let n2 = 0;
  text = text.replace(
    /^(\s*)versionName\s*=\s*"[^"]*"/m,
    (_match, indent: string) => {
      n1 += 1;
      return `${indent}versionName = "${version}"`;
    },
  );
  text = text.replace(
    /^(\s*)versionCode\s*=\s*\d+/m,
    (_match, indent: string) => {
      n2 += 1;
      return `${indent}versionCode = ${code}`;
    },
  );
  if (n1 !== 1 || n2 !== 1) {
    die(
      `failed to update Android version (versionName=${n1}, versionCode=${n2})`,
    );
  }
  writeFileSync(gradle, text);
}

function main(): void {
  let target = process.env.usage_target;
  if (!target) {
    if (process.argv.length > 2) {
      target = process.argv[2];
    } else {
      die(
        "missing target (run via: mise run release:bump <X.Y.Z|patch|minor|major>)",
      );
    }
  }

  if (!existsSync(CARGO_TOML)) die(`missing ${CARGO_TOML}`);
  if (!existsSync(ANDROID_GRADLE)) die(`missing ${ANDROID_GRADLE}`);

  const current = readWorkspaceVersion(CARGO_TOML);
  let version: string;
  if (target === "patch" || target === "minor" || target === "major") {
    version = bumpSemver(current, target);
  } else {
    parseSemver(target); // validate
    version = target;
  }

  const parts = parseSemver(version);
  const code = versionCode(parts);

  writeWorkspaceVersion(CARGO_TOML, version);
  writeAndroidVersion(ANDROID_GRADLE, version, code);

  console.log(`bumped ${current} -> ${version} (Android versionCode=${code})`);
  console.log(`  ${relative(ROOT, CARGO_TOML)}`);
  console.log(`  ${relative(ROOT, ANDROID_GRADLE)}`);
}

main();
