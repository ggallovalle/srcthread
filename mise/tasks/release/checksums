#!/usr/bin/env bun
// vim: set ft=typescript:
//MISE description="Write SHASUMS256.txt for staged release artifacts"
//USAGE arg "[dist-dir]" help="Directory of release artifacts (default: dist/)"

import { join } from "node:path";
import { resolveMiseEnv, type MiseEnv } from "~/mise-env.ts";

/** Mirrors //USAGE above. */
export type Command = {
  distDir: string | null;
};

export function parseCommand(
  env: NodeJS.ProcessEnv = process.env,
): Command {
  const raw = env.usage_dist_dir?.trim();
  return { distDir: raw || null };
}

export async function main(command: Command, mise: MiseEnv): Promise<number> {
  const dist = command.distDir || join(mise.projectRoot, "dist");
  const distOk = await Bun.$`test -d ${dist}`.nothrow().quiet();
  if (distOk.exitCode !== 0) {
    console.error(`dist directory not found: ${dist}`);
    return 1;
  }

  const names: string[] = [];
  for await (const match of new Bun.Glob("*").scan({
    cwd: dist,
    onlyFiles: true,
  })) {
    if (match === "SHASUMS256.txt") continue;
    names.push(match);
  }
  names.sort();

  if (names.length === 0) {
    console.error(`no artifacts in ${dist}`);
    return 1;
  }

  const lines: string[] = [];
  for (const name of names) {
    const path = join(dist, name);
    const hasher = new Bun.CryptoHasher("sha256");
    hasher.update(await Bun.file(path).arrayBuffer());
    // GNU sha256sum: "<hex>  <name>"
    lines.push(`${hasher.digest("hex")}  ${name}`);
  }
  const body = `${lines.join("\n")}\n`;
  await Bun.write(join(dist, "SHASUMS256.txt"), body);
  console.log(`Wrote ${dist}/SHASUMS256.txt (${names.length} files)`);
  console.log(body.trimEnd());
  return 0;
}

if (import.meta.main) {
  process.exit(await main(parseCommand(), resolveMiseEnv()));
}
