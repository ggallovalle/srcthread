#!/usr/bin/env bun
// vim: set ft=typescript:
//MISE description="Cut a GitHub release (tarballs, APK, checksums, packslip-sign)"
//USAGE arg "<version>" help="Semver to publish (must match Cargo.toml)"
//USAGE flag "--dry-run" help="Build artifacts only; no tag, gh release, or packslip"
//USAGE flag "--skip-android" help="Skip Android APK"
//USAGE flag "--skip-desktop" help="Skip desktop variant tarball"
//USAGE flag "--host-only" help="Only build the current rustc host triple"
/**
 * Env:
 *   HOST_TRIPLE    Override rustc host triple for --host-only builds.
 */

import { mkdir, rm } from "node:fs/promises";
import { join } from "node:path";
import { resolveMiseEnv, type MiseEnv } from "~/mise-env.ts";
import { rustcHostTriple } from "~/rust.ts";
import { readCliVersion } from "~/version.ts";

const SEMVER_RE = /^[0-9]+\.[0-9]+\.[0-9]+([.-].+)?$/;

const PLATFORM_TRIPLES = [
  "x86_64-unknown-linux-gnu",
  "aarch64-unknown-linux-gnu",
  "x86_64-apple-darwin",
  "aarch64-apple-darwin",
] as const;

/** Mirrors //USAGE above. */
export type Command = {
  version: string;
  dryRun: boolean;
  skipAndroid: boolean;
  skipDesktop: boolean;
  hostOnly: boolean;
};

export function parseCommand(
  env: NodeJS.ProcessEnv = process.env,
): Command | { error: string } {
  const version = env.usage_version?.trim();
  if (!version) {
    return { error: "missing required arg <version> (usage_version)" };
  }
  return {
    version,
    dryRun: env.usage_dry_run === "true",
    skipAndroid: env.usage_skip_android === "true",
    skipDesktop: env.usage_skip_desktop === "true",
    hostOnly: env.usage_host_only === "true",
  };
}

async function buildOne(
  root: string,
  triple: string,
  variant: "default" | "desktop",
): Promise<number> {
  const result =
    await Bun.$`mise run release:tarball ${triple} ${variant}`.cwd(root).nothrow();
  return result.exitCode;
}

/** null = build; otherwise a skip log line. */
async function skipTripleReason(
  root: string,
  triple: string,
  hostTriple: string,
): Promise<string | null> {
  if (triple === hostTriple) return null;
  if (triple.endsWith("-apple-darwin")) {
    return process.platform === "darwin"
      ? null
      : `skip ${triple} (not on macOS)`;
  }
  if (triple.endsWith("-linux-gnu")) {
    if (process.platform !== "linux") return `skip ${triple} (not on Linux)`;
    const installed =
      await Bun.$`rustup target list --installed`.cwd(root).nothrow().text();
    const ok = installed
      .split("\n")
      .map((l) => l.trim())
      .includes(triple);
    return ok ? null : `skip ${triple} (rustup target not installed)`;
  }
  return null;
}

export async function main(command: Command, mise: MiseEnv): Promise<number> {
  const root = mise.projectRoot;
  const { version } = command;
  if (!SEMVER_RE.test(version)) {
    console.error(`version must look like semver (got: ${version})`);
    return 1;
  }

  const tag = `v${version}`;
  const notesFile = join(root, "release-notes", `${version}.md`);
  const hostOverride = process.env.HOST_TRIPLE?.trim();
  let hostTriple = hostOverride || "";
  if (!hostTriple) {
    const host = await rustcHostTriple(root);
    if (typeof host !== "string") {
      console.error(host.error);
      return 1;
    }
    hostTriple = host;
  }

  console.log(
    `==> publish ${tag} (dry_run=${command.dryRun} host_only=${command.hostOnly})`,
  );

  const notes = Bun.file(notesFile);
  if (!(await notes.exists())) {
    console.error(`missing release notes: ${notesFile}`);
    console.error("Write GitHub release notes there before publishing.");
    return 1;
  }
  if ((await notes.text()).trim().length === 0) {
    console.error(`release notes file is empty: ${notesFile}`);
    return 1;
  }

  if (!command.dryRun) {
    const dirty = await Bun.$`git status --porcelain`.cwd(root).text();
    if (dirty.trim()) {
      console.error("working tree is dirty; commit or stash first");
      return 1;
    }
    const gh = await Bun.$`command -v gh`.nothrow().quiet();
    if (gh.exitCode !== 0) {
      console.error("gh is required");
      return 1;
    }
    await Bun.$`gh auth status`.cwd(root).quiet();
  }

  const pkgVersion = await readCliVersion(root);
  if (typeof pkgVersion !== "string") {
    console.error(pkgVersion.error);
    return 1;
  }
  if (pkgVersion !== version) {
    console.error(
      `Cargo.toml version is ${pkgVersion} but publish asked for ${version}`,
    );
    console.error("bump with: mise run release:bump <version>");
    return 1;
  }

  await rm(join(root, "dist"), { recursive: true, force: true });
  await mkdir(join(root, "dist"), { recursive: true });

  console.log("==> release assets (usage, completions, man)");
  await Bun.$`mise run render:usage --dist`.cwd(root);

  if (command.hostOnly) {
    console.log(`==> host-only tarball (${hostTriple})`);
    if ((await buildOne(root, hostTriple, "default")) !== 0) return 1;
    if (!command.skipDesktop) {
      if ((await buildOne(root, hostTriple, "desktop")) !== 0) {
        console.error(
          "warning: desktop variant build failed; continuing without it",
        );
      }
    }
  } else {
    console.log("==> platform tarballs");
    for (const triple of PLATFORM_TRIPLES) {
      const skip = await skipTripleReason(root, triple, hostTriple);
      if (skip) {
        console.log(skip);
        continue;
      }
      if ((await buildOne(root, triple, "default")) !== 0) return 1;
      if (!command.skipDesktop) {
        if ((await buildOne(root, triple, "desktop")) !== 0) {
          console.error(`warning: desktop build failed for ${triple}`);
        }
      }
    }
  }

  if (!command.skipAndroid) {
    console.log("==> Android release APK");
    if (!process.env.ANDROID_HOME && !process.env.ANDROID_SDK_ROOT) {
      console.error(
        "ANDROID_HOME/ANDROID_SDK_ROOT unset; skip APK (pass --skip-android to silence)",
      );
    } else {
      await Bun.$`./gradlew :apps:android:assembleRelease`.cwd(root);
      const apkDir = join(
        root,
        "apps/android/build/outputs/apk/release",
      );
      let apk: string | null = null;
      for await (const match of new Bun.Glob("*.apk").scan({
        cwd: apkDir,
        onlyFiles: true,
      })) {
        apk = join(apkDir, match);
        break;
      }
      if (!apk) {
        console.error("assembleRelease produced no APK");
        return 1;
      }
      const dest = join(root, "dist", `srcthread-${version}-android.apk`);
      await Bun.write(dest, Bun.file(apk));
      await Bun.$`ls -lh ${dest}`.cwd(root);
    }
  }

  await Bun.$`mise run release:checksums`.cwd(root);

  // Never ship a key-signed packslip from this script — mise consumers of a
  // github.com project expect keyless OIDC. Sign after the release exists:
  //   gh workflow run packslip-sign.yml -f tag=v<version>
  await rm(join(root, "dist", "packslip.sigstore.json"), { force: true });

  if (command.dryRun) {
    console.log("==> dry-run complete; artifacts in dist/");
    console.log(
      "    (packslip is keyless via packslip-sign.yml after a real publish)",
    );
    await Bun.$`ls -lh dist/`.cwd(root);
    return 0;
  }

  console.log(`==> tag ${tag}`);
  const tagExists = await Bun.$`git rev-parse ${tag}`.cwd(root).nothrow().quiet();
  if (tagExists.exitCode === 0) {
    console.error(`tag ${tag} already exists`);
    return 1;
  }
  await Bun.$`git tag -a ${tag} -m ${tag}`.cwd(root);
  await Bun.$`git push origin refs/tags/${tag}`.cwd(root);

  console.log("==> GitHub release");
  const assets: string[] = [];
  for await (const match of new Bun.Glob("*").scan({
    cwd: join(root, "dist"),
    onlyFiles: true,
  })) {
    assets.push(join(root, "dist", match));
  }
  await Bun.$`gh release create ${tag} ${assets} --title ${tag} --notes-file ${notesFile} --verify-tag`.cwd(
    root,
  );

  console.log("==> packslip-sign (keyless CI)");
  await Bun.$`gh workflow run packslip-sign.yml -f tag=${tag}`.cwd(root);
  await Bun.sleep(3000);
  const runId = (
    await Bun.$`gh run list --workflow=packslip-sign.yml --limit 1 --json databaseId --jq .[0].databaseId`
      .cwd(root)
      .text()
  ).trim();
  if (!runId || runId === "null") {
    console.error("could not find packslip-sign run; check Actions tab");
    return 1;
  }
  console.log(`watching run ${runId}`);
  await Bun.$`gh run watch ${runId} --exit-status`.cwd(root);

  console.log(`
Published ${tag} with keyless packslip.

Install (PC):

  [tools]
  "packslip:github.com/ggallovalle/srcthread" = { version = "${version}", variant = "desktop" }

Optional postinstall:

  postinstall = "srcthread integration install cursor --user && srcthread desktop install-xdg"

Android: download srcthread-${version}-android.apk from the release.
`);
  return 0;
}

if (import.meta.main) {
  const parsed = parseCommand();
  if ("error" in parsed) {
    console.error(parsed.error);
    process.exit(2);
  }
  process.exit(await main(parsed, resolveMiseEnv()));
}
