#!/usr/bin/env bun
// vim: set ft=typescript:
//MISE description="Regenerate usage KDL, completions, and man page"
//USAGE flag "--dist" help="Also copy flat assets into dist/ for GitHub releases"
/**
 * Writes:
 *   srcthread.usage.kdl
 *   completion/srcthread.{bash,fish,ps1} and completion/_srcthread
 *   man/man1/srcthread.1
 */

import { mkdir } from "node:fs/promises";
import { join } from "node:path";
import { resolveMiseEnv, type MiseEnv } from "~/mise-env.ts";

/** Mirrors //USAGE above. */
export type Command = {
  dist: boolean;
};

export function parseCommand(
  env: NodeJS.ProcessEnv = process.env,
): Command {
  return { dist: env.usage_dist === "true" };
}

export async function main(command: Command, mise: MiseEnv): Promise<number> {
  const root = mise.projectRoot;
  await mkdir(join(root, "completion"), { recursive: true });
  await mkdir(join(root, "man", "man1"), { recursive: true });

  // Same CLI surface as CI (no Wayland/Vulkan link deps).
  const kdl =
    await Bun.$`cargo run -qp srcthread-cli --no-default-features -- __usage_spec__`
      .cwd(root)
      .text();
  await Bun.write(join(root, "srcthread.usage.kdl"), kdl);

  const shells = [
    ["bash", "completion/srcthread.bash"],
    ["zsh", "completion/_srcthread"],
    ["fish", "completion/srcthread.fish"],
    ["powershell", "completion/srcthread.ps1"],
  ] as const;

  for (const [shell, out] of shells) {
    const text =
      await Bun.$`usage generate completion ${shell} srcthread -f srcthread.usage.kdl`
        .cwd(root)
        .text();
    await Bun.write(join(root, out), text);
  }

  await Bun.$`usage generate manpage -f srcthread.usage.kdl -o man/man1/srcthread.1`.cwd(
    root,
  );

  if (command.dist) {
    await mkdir(join(root, "dist"), { recursive: true });
    const copies: Array<[string, string]> = [
      ["srcthread.usage.kdl", "dist/srcthread.usage.kdl"],
      ["completion/srcthread.bash", "dist/srcthread.bash"],
      ["completion/_srcthread", "dist/srcthread.zsh"],
      ["completion/srcthread.fish", "dist/srcthread.fish"],
      ["completion/srcthread.ps1", "dist/srcthread.powershell"],
    ];
    for (const [from, to] of copies) {
      await Bun.write(join(root, to), Bun.file(join(root, from)));
    }
    console.log("Staged release assets under dist/");
  }

  return 0;
}

if (import.meta.main) {
  process.exit(await main(parseCommand(), resolveMiseEnv()));
}
