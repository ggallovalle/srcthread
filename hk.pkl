amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

min_hk_version = "2.8.1"

local rustFiles = List("**/*.rs", "Cargo.toml", "Cargo.lock")
local androidKotlin = List(
  "apps/android/**/*.kt",
  "apps/android/**/*.kts",
  "ktpackages/**/*.kt",
  "ktpackages/**/*.kts",
  "settings.gradle.kts",
  "build.gradle.kts",
  "detekt.yaml"
)

// Builtins: cargo fmt (with fix) and clippy, tightened to deny warnings.
local cargoFmt = Builtins.cargo_fmt

// CI cargo matrix lives in mise (`clippy-ci` / `test-ci`): one source of truth
// for which packages GitHub Actions builds. Custom step (not
// Builtins.cargo_clippy) so we do not fan out once per Cargo.toml.
local clippy = new Step {
  glob = rustFiles
  depends = "cargo_fmt"
  check = "mise run clippy-ci"
  fix = "cargo clippy -p srcthread -p srcthread-mcp -p srcthread-uniffi -p srcthread-cli --no-default-features --fix --allow-dirty --allow-staged --all-targets -- -D warnings"
}

local test = new Step {
  glob = rustFiles
  depends = List("cargo_fmt", "clippy")
  check = "mise run test-ci"
}

// Builtins: rumdl formatting, then its lint rules.
local rumdlFormat = Builtins.rumdl_format

local rumdlLint = new Step {
  types = List("markdown")
  depends = "rumdl_format"
  check = "rumdl check {{files}}"
  fix = "rumdl check --fix {{files}}"
}

local tombi = Builtins.tombi_format

// Android Kotlin lint via Gradle detekt (journalit-aligned config).
// Skips cleanly when gradlew is missing; CI rust matrix does not require SDK.
local detekt = new Step {
  glob = androidKotlin
  check = "mise run detekt"
  exclusive = true
}

// Formatters and static checks only. Safe during a TDD red pass.
local lintSteps = new Mapping<String, Step> {
  ["cargo_fmt"] = cargoFmt
  ["clippy"] = clippy
  ["rumdl_format"] = rumdlFormat
  ["rumdl_lint"] = rumdlLint
  ["tombi_format"] = tombi
  ["detekt"] = detekt
}

// Keep `srcthread.usage.kdl` + `completion/` aligned with the usage-rs CLI.
// Pre-commit only (not lint/CI). Exclusive: cargo run shares the target dir
// with clippy.
local renderUsage = new Step {
  glob = List(
    "crates/srcthread-cli/**/*.rs",
    "crates/srcthread-cli/Cargo.toml",
    "srcthread.usage.kdl",
    "completion/**"
  )
  depends = "cargo_fmt"
  exclusive = true
  stage = List(
    "srcthread.usage.kdl",
    "completion/_srcthread",
    "completion/srcthread.bash",
    "completion/srcthread.fish",
    "completion/srcthread.ps1"
  )
  fix = "mise run render:usage"
}

hooks {
  // `mise run lint` / `hk run lint --all`
  ["lint"] {
    steps = lintSteps
  }

  // Prefer `mise run check-ci` (what GHA runs). `hk check --all` stays as a
  // local equivalent that shares the same clippy-ci / test-ci tasks.
  ["check"] {
    steps {
      ...lintSteps
      ["test"] = test
    }
  }

  // Commits: lint/format only so intentional failing tests can be committed.
  // Full `check` (including tests) is enforced by CI on PRs into main.
  // `render_usage` regenerates the committed usage spec + shell completions.
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps {
      ...lintSteps
      ["render_usage"] = renderUsage
    }
  }
}
